# Copy this file to ".env" and edit the values.
# The app reads these at startup.

# --- Database ---------------------------------------------------------------
# SQLite (default). The file path is relative to where you run the app.
# Use an ABSOLUTE path in production so the database never ends up in a
# folder that the host wipes on restart. Example on a Linux host:
#   DATABASE_URL=sqlite:////data/thorfinn.db      (note the four slashes)
DATABASE_URL=sqlite:///./thorfinn.db

# To use a free hosted PostgreSQL later, install "psycopg[binary]" and set:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Security ---------------------------------------------------------------
# CHANGE THIS to a long random string before going live.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me

# Set to "true" when served over HTTPS (production). Keep "false" for local dev.
COOKIE_SECURE=false

# How long an admin stays logged in, in seconds (default 7 days).
SESSION_MAX_AGE=604800

# --- Map defaults -----------------------------------------------------------
# Abuja city centre, used as the initial map view.
ABUJA_LAT=9.0579
ABUJA_LNG=7.4951
